{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SylphxAI/repomap",
  "title": "repomap",
  "description": "A map of your codebase for AI agents: code graph, search, call paths and change impact. No API key.",
  "repository": {
    "url": "https://github.com/SylphxAI/repomap",
    "source": "github"
  },
  "version": "1.2.3",
  "websiteUrl": "https://sylphxai.github.io/repomap/",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@sylphx/repomap",
      "version": "1.2.3",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
