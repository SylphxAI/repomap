{
  "name": "@sylphx/spine",
  "version": "0.3.1",
  "mcpName": "io.github.SylphxAI/spine",
  "type": "module",
  "description": "Spine \u2014 local architecture engine for agents. Index, search, path, impact with file:line evidence. SDK \u00b7 CLI \u00b7 MCP.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bin": {
    "spine": "./bin/spine"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "bin/spine",
    "bin/spine",
    "src/"
  ],
  "exports": {
    ".": "./src/tools.ts",
    "./doctor": "./src/doctor.ts",
    "./tools": "./src/tools.ts",
    "./spine": "./src/spine-sdk.ts",
    "./sdk": "./src/spine-sdk.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylphxAI/architecture-reader-mcp.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/SylphxAI/architecture-reader-mcp#readme",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun -e \"import { accessSync } from 'node:fs'; accessSync('src/tools.ts'); console.log('prepublish ok')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "private": false,
  "optionalDependencies": {
    "@sylphx/spine-darwin-arm64": "0.3.1",
    "@sylphx/spine-darwin-x64": "0.3.1",
    "@sylphx/spine-linux-x64-gnu": "0.3.1",
    "@sylphx/spine-linux-arm64-gnu": "0.3.1"
  }
}
