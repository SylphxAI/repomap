{
  "name": "@sylphx/spine",
  "version": "0.4.5",
  "mcpName": "io.github.SylphxAI/spine",
  "type": "module",
  "description": "Spine — repository architecture with file-level proof. Local graph, paths, traces, and impact.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bin": {
    "spine": "./bin/spine"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "bin/spine",
    "bin/spine",
    "src/"
  ],
  "exports": {
    ".": "./src/tools.ts",
    "./doctor": "./src/doctor.ts",
    "./tools": "./src/tools.ts",
    "./spine": "./src/spine-sdk.ts",
    "./sdk": "./src/spine-sdk.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SylphxAI/spine.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://sylphxai.github.io/spine/",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun -e \"import { accessSync } from 'node:fs'; accessSync('src/tools.ts'); console.log('prepublish ok')\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitepress": "1.6.4"
  },
  "private": false,
  "optionalDependencies": {
    "@sylphx/spine-darwin-arm64": "0.4.5",
    "@sylphx/spine-darwin-x64": "0.4.5",
    "@sylphx/spine-linux-x64-gnu": "0.4.5",
    "@sylphx/spine-linux-arm64-gnu": "0.4.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-analysis",
    "repository-analysis",
    "software-architecture",
    "code-understanding",
    "impact-analysis",
    "call-graph",
    "dependency-graph",
    "ast",
    "code-navigation",
    "agent-context",
    "local-first",
    "rust",
    "developer-tools",
    "ai-agents",
    "spine",
    "sylphx"
  ]
}
