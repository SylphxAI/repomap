{
  "name": "@sylphx/spine",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Spine monorepo (publishable package: packages/mcp-server \u2192 @sylphx/spine).",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate:json": "python3 -m json.tool .doctrine/project.json >/dev/null && python3 -m json.tool project.manifest.json >/dev/null",
    "validate": "bun run validate:json",
    "build:rust": "cargo build --release -p architecture-reader-core -p architecture-reader-cli -p architecture-reader-mcp-server && bun scripts/stage-rust-mcp.ts",
    "build": "bun run build:rust",
    "test": "cargo test && bun test",
    "doctor": "bun run packages/mcp-server/src/doctor.ts",
    "benchmark:public-proof": "bun run build:rust && bun run scripts/benchmark-public-proof.ts",
    "benchmark:release-gate": "bun run build:rust && bun run scripts/release-gate.ts",
    "sync:server-json": "bun scripts/sync-server-json.ts",
    "version-packages": "changeset version && bun run sync:server-json",
    "release": "bun test && changeset publish",
    "brand:pack-plan": "bun scripts/brand-pack-plan.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SylphxAI/architecture-reader-mcp.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@sylphx/synth-js": "^0.2.0"
  },
  "mcpName": "io.github.SylphxAI/spine",
  "bin": {
    "spine": "./bin/spine"
  }
}
